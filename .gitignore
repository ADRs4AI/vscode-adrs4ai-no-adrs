# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Temporary files
~*
temp

# Python
__pycache__/
*.py[cod]

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
out/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# VS Code test runner
.vscode-test/

# Environment
.env
.env.local

# Editor
*.swp
*.swo

# Packaged extension builds (regenerable via `npx @vscode/vsce package`; kept locally in releases/)
releases/
*.vsix

# LaTeX build artifacts (docs/submissions keeps .tex + .pdf tracked)
docs/submissions/*.aux
docs/submissions/*.log
docs/submissions/*.out

# Local research clones — external repos, reproducible from URLs in docs/research/README.md
docs/research/*/

# ADR-0025: per-root watcher instrumentation log. The file, not the whole
# docs/adr/.settings/ folder — roots.json (allow/block config) is meant to
# be committed and shared with the team; metrics.log is a local audit trail.
docs/adr/.settings/metrics.log